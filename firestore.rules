rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return request.auth.token.admin == true;
    }

    function isLeagueAdmin(leagueId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.adminUids;
    }

    // Un pronostic est verrouillé si la course est annulée, ou si son heure
    // de départ (raceStartAt) est déjà passée selon l'horloge serveur.
    // raceId est stocké comme un nombre sur les documents predictions/races
    // (ex. 17, ou 17.5 pour Bahreïn/Sepang) — string() est nécessaire pour
    // construire un chemin de document Firestore valide à partir de ce nombre.
    function raceIsLocked(raceId) {
      let race = get(/databases/$(database)/documents/races/$(string(raceId))).data;
      return race.status == 'cancelled'
        || (race.raceStartAt != null && request.time >= race.raceStartAt);
    }

    // Un joueur ne peut supprimer son propre pronostic que tant que la
    // bascule n'est pas passée (request.time < races/{raceId}.qualifyingStartAt,
    // début de la séance "Qualifying"). Sans cette limite, supprimer puis
    // recréer un pronostic transformerait une modification (pénalisée) en
    // simple création. Repli sur !raceIsLocked quand qualifyingStartAt est
    // absent.
    function playerMayDeleteOwnPrediction(raceId) {
      let race = get(/databases/$(database)/documents/races/$(string(raceId))).data;
      return race.get('qualifyingStartAt', null) != null
        ? request.time < race.qualifyingStartAt
        : !raceIsLocked(raceId);
    }

    // ── Interventions d'un admin sur un pronostic (transparence envers la ligue) ──
    // Un admin (de la ligue, ou super-admin) n'écrit un pronostic qu'en même temps qu'une entrée de journal
    // `adminLog` (même lot d'écritures). Le pronostic porte `adminEntry` : { logId, at, ... } ; la règle
    // vérifie que le journal existe APRÈS le lot (et y est écrit : at == request.time), qu'il vise ce pronostic,
    // qu'il est écrit par cet admin dans cette ligue, et que `adminEntry.at` est l'heure du serveur de cette écriture (les fonctions
    // serveur reconnaissent ainsi une écriture d'admin : adminEntry.at == updatedAt).
    function adminWriteLogged(predId, data) {
      return data.adminEntry is map
        && data.adminEntry.logId is string
        && data.adminEntry.at == request.time
        && data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/adminLog/$(data.adminEntry.logId))
        && getAfter(/databases/$(database)/documents/adminLog/$(data.adminEntry.logId)).data.predictionId == predId
        && getAfter(/databases/$(database)/documents/adminLog/$(data.adminEntry.logId)).data.byUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/adminLog/$(data.adminEntry.logId)).data.leagueId == data.leagueId
        // Le journal doit être écrit dans CE lot : un ancien journal ne peut pas servir de caution à une nouvelle intervention.
        && getAfter(/databases/$(database)/documents/adminLog/$(data.adminEntry.logId)).data.at == request.time;
    }

    // ── Pénalités posées ou retirées par un admin : même principe, journal obligatoire dans le même lot ──
    // Ajout : le journal `add_<id de la pénalité>` (kind penalty-add), OU le journal d'une saisie ou correction de
    // pronostic (adminLogId : la pénalité choisie dans le formulaire de l'admin) ; dans les deux cas il vise le
    // même joueur, le même GP et la même ligue, est écrit par cet admin et dans CE lot (at == request.time).
    // Retrait : le journal `rm_<id de la pénalité>` (kind penalty-remove) dans le même lot.
    function penaltyAddLogged(penId, pen) {
      return (
        existsAfter(/databases/$(database)/documents/adminLog/$('add_' + penId))
        && getAfter(/databases/$(database)/documents/adminLog/$('add_' + penId)).data.kind == 'penalty-add'
        && getAfter(/databases/$(database)/documents/adminLog/$('add_' + penId)).data.penaltyId == penId
        && getAfter(/databases/$(database)/documents/adminLog/$('add_' + penId)).data.playerId == pen.playerId
        && getAfter(/databases/$(database)/documents/adminLog/$('add_' + penId)).data.raceId == pen.raceId
        && getAfter(/databases/$(database)/documents/adminLog/$('add_' + penId)).data.leagueId == pen.leagueId
        && getAfter(/databases/$(database)/documents/adminLog/$('add_' + penId)).data.byUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/adminLog/$('add_' + penId)).data.at == request.time
      ) || (
        pen.adminLogId is string
        && existsAfter(/databases/$(database)/documents/adminLog/$(pen.adminLogId))
        && getAfter(/databases/$(database)/documents/adminLog/$(pen.adminLogId)).data.kind in ['prediction-create', 'prediction-edit']
        && getAfter(/databases/$(database)/documents/adminLog/$(pen.adminLogId)).data.playerId == pen.playerId
        && getAfter(/databases/$(database)/documents/adminLog/$(pen.adminLogId)).data.raceId == pen.raceId
        && getAfter(/databases/$(database)/documents/adminLog/$(pen.adminLogId)).data.leagueId == pen.leagueId
        && getAfter(/databases/$(database)/documents/adminLog/$(pen.adminLogId)).data.byUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/adminLog/$(pen.adminLogId)).data.at == request.time
      );
    }

    function penaltyRemovalLogged(penId, pen) {
      return existsAfter(/databases/$(database)/documents/adminLog/$('rm_' + penId))
        && getAfter(/databases/$(database)/documents/adminLog/$('rm_' + penId)).data.kind == 'penalty-remove'
        && getAfter(/databases/$(database)/documents/adminLog/$('rm_' + penId)).data.penaltyId == penId
        && getAfter(/databases/$(database)/documents/adminLog/$('rm_' + penId)).data.playerId == pen.playerId
        && getAfter(/databases/$(database)/documents/adminLog/$('rm_' + penId)).data.raceId == pen.raceId
        && getAfter(/databases/$(database)/documents/adminLog/$('rm_' + penId)).data.leagueId == pen.leagueId
        && getAfter(/databases/$(database)/documents/adminLog/$('rm_' + penId)).data.byUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/adminLog/$('rm_' + penId)).data.at == request.time;
    }

    // ── leagues ──────────────────────────────────────────────────────────
    match /leagues/{leagueId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.adminUids == [request.auth.uid];

      // Co-administration : n'importe quel admin peut modifier adminUids
      // (nommer/démettre), mais uniquement si l'auteur de l'écriture reste
      // lui-même présent dans le tableau résultant. Cette seule condition
      // empêche à la fois l'auto-démotion et la suppression du dernier
      // admin restant, puisque le seul admin capable d'appeler cette règle
      // quand adminUids.size() == 1 est cet admin lui-même.
      allow update: if isSuperAdmin()
        || (
          isLeagueAdmin(leagueId)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminUids'])
            || request.auth.uid in request.resource.data.adminUids
          )
        );

      allow delete: if isSuperAdmin() || isLeagueAdmin(leagueId);
    }

    // ── profiles ─────────────────────────────────────────────────────────
    // Identité de l'utilisateur (id = authUid), distincte de l'appartenance
    // à une ligue (players). Chacun ne peut créer/modifier que son propre
    // profil ; suppression réservée au super-admin.
    match /profiles/{profileId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == profileId;
      allow delete: if isSuperAdmin();
    }

    // ── players ──────────────────────────────────────────────────────────
    match /players/{playerId} {
      allow read: if isSignedIn();

      allow update: if isSuperAdmin()
        || isLeagueAdmin(resource.data.leagueId)
        // Self, toggling membership status only (LeaveLeagueSheet.jsx,
        // RejoindreLigue.jsx) — never any other field on one's own doc.
        // A banned player cannot self-reactivate (set active: true) even
        // via a direct Firestore call ; only an admin can clear `banned`
        // (handled by the isLeagueAdmin() disjunct above, no change needed
        // there — it already allows writing any field).
        || (
          resource.data.authUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt'])
          && !(resource.data.banned == true && request.resource.data.active == true)
        )
        || (
          resource.data.authUid == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid', 'updatedAt'])
          && request.resource.data.authUid == request.auth.uid
        )
        // Self, unlinking on account deletion (MonProfil.jsx) — clears
        // authUid and swaps in a neutral display override, nothing else.
        || (
          resource.data.authUid == request.auth.uid
          && request.resource.data.authUid == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid', 'displayNameOverride', 'updatedAt'])
        );

      allow create: if isSuperAdmin()
        || isLeagueAdmin(request.resource.data.leagueId)
        || request.resource.data.authUid == request.auth.uid;

      // Uses resource.data (the existing document), not request.resource —
      // request.resource is undefined on delete.
      allow delete: if isSuperAdmin() || isLeagueAdmin(resource.data.leagueId);
    }

    // ── predictions ──────────────────────────────────────────────────────
    match /predictions/{predId} {
      allow read: if isSignedIn();

      // create uses request.resource (the document doesn't exist yet, so
      // resource.data would be undefined); update/delete use resource (the
      // existing document), since request.resource is undefined on delete.
      // Un admin passe par la branche « admin » (journal obligatoire, voir adminWriteLogged) ; un joueur
      // (admin ou non) écrit son propre pronostic tant que le GP n'a pas démarré, sans journal.
      allow create: if ((isSuperAdmin() || isLeagueAdmin(request.resource.data.leagueId))
          && adminWriteLogged(predId, request.resource.data))
        || (
          get(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.authUid == request.auth.uid
          && !raceIsLocked(request.resource.data.raceId)
        );

      // The "own prediction" clause is field-restricted: a player may only
      // ever touch the content of their own pronostic and its own tracking
      // fields (matches every upsertDoc('predictions', ...) a player
      // triggers themselves, in PredictionSheet.jsx's savePrediction) —
      // never manualUnlockOverride, which must stay admin-only (see
      // ReglagesLigue.jsx's toggleManualUnlock). Without this, a player
      // could grant themselves the "race started" edit-lock exception
      // directly via the API, bypassing the admin-only intent.
      allow update: if ((isSuperAdmin() || isLeagueAdmin(resource.data.leagueId))
          && adminWriteLogged(predId, request.resource.data))
        || (
          get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.authUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'prediction', 'initialPrediction', 'submittedAt', 'modifiedAt', 'modificationCount', 'leagueId', 'updatedAt'
          ])
          && (!raceIsLocked(resource.data.raceId) || resource.data.manualUnlockOverride == true)
        );

      // Seul le joueur supprime son propre pronostic (et seulement avant les qualifs). Un admin ne supprime
      // JAMAIS le pronostic d'un autre : il le corrige, avec journal et motif (voir adminWriteLogged), pour
      // qu'aucune intervention ne puisse se faire en silence. Ménage technique : script serveur (SDK admin).
      allow delete: if (
          get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.authUid == request.auth.uid
          && playerMayDeleteOwnPrediction(resource.data.raceId)
        );
    }

    // ── penalties ────────────────────────────────────────────────────────
    match /penalties/{penId} {
      allow read: if isSignedIn();

      // Seuls les admins (de la ligue, ou super-admin) créent des pénalités à la main, et seulement avec leur
      // entrée dans le journal `adminLog` (même lot : motif, qui, quand). Les pénalités automatiques sont
      // écrites par les Cloud Functions (SDK admin, qui contourne les règles).
      allow create: if (isSuperAdmin() || isLeagueAdmin(request.resource.data.leagueId))
        && penaltyAddLogged(penId, request.resource.data);

      // Une pénalité ne se modifie jamais (on la retire, puis on en ajoute une autre si besoin). Son retrait par
      // un admin passe lui aussi par le journal. La suppression d'une ligue ne supprime plus les pénalités.
      allow update: if false;
      allow delete: if (isSuperAdmin() || isLeagueAdmin(resource.data.leagueId))
        && penaltyRemovalLogged(penId, resource.data);
    }

    // ── adminLog : journal des interventions des admins (ajout seul) ───────────────
    // Lecture pour tout compte connecté (comme le reste des données de ligue). Création réservée à un admin
    // de la ligue concernée (ou au super-admin), au nom de son propre compte, à l'heure du serveur, avec un
    // motif lisible. Aucune modification ni suppression, pour personne : l'historique ne se réécrit pas.
    match /adminLog/{logId} {
      allow read: if isSignedIn();

      allow create: if (isSuperAdmin() || isLeagueAdmin(request.resource.data.leagueId))
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.motif is string
        && request.resource.data.motif.trim().size() >= 5
        && request.resource.data.motif.size() <= 200
        && request.resource.data.playerId is string
        && request.resource.data.raceId is number
        && (
          (
            request.resource.data.kind in ['prediction-create', 'prediction-edit']
            && request.resource.data.predictionId is string
            && request.resource.data.after is map
          ) || (
            // Pénalité ajoutée ou retirée : l'identifiant du journal est déterministe (add_ ou rm_ + id de la
            // pénalité), ce qui lie un journal à UNE seule pénalité.
            request.resource.data.kind in ['penalty-add', 'penalty-remove']
            && request.resource.data.penaltyId is string
            && request.resource.data.penaltyType in ['late', 'change']
            && request.resource.data.penaltyAmount is number
            && logId == (request.resource.data.kind == 'penalty-add' ? 'add_' : 'rm_') + request.resource.data.penaltyId
          )
        );

      allow update, delete: if false;
    }

    // ── races, drivers, races_history, config ───────────────────────────────
    // Données partagées entre toutes les ligues (pas propres à une ligue) :
    // lecture libre, écriture réservée au super-admin uniquement.
    match /races/{raceId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /races_history/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Interdit tout le reste par défaut ───────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
