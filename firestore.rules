rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return request.auth.token.admin == true;
    }

    function isLeagueAdmin(leagueId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.adminUids;
    }

    // Same "own player doc" mechanism already used by the predictions rules
    // (get the players/{playerId} doc and compare authUid), plus an extra
    // check that the player's own leagueId actually matches the leagueId
    // being written — predictions doesn't enforce this today, but we want
    // it here since penalties self-service is a new, narrower capability.
    function isOwnPlayerInLeague(playerId, leagueId) {
      let player = get(/databases/$(database)/documents/players/$(playerId)).data;
      return isSignedIn()
        && player.authUid == request.auth.uid
        && player.leagueId == leagueId;
    }

    // The league's modification-penalty rule must be enabled, and the
    // amount on the incoming penalty must exactly match the currently
    // configured amount — a player can never write an arbitrary amount.
    function matchesModificationPenaltyRule(leagueId, amount) {
      let rules = get(/databases/$(database)/documents/leagues/$(leagueId)).data.rules;
      return rules.modificationPenalty.enabled == true
        && rules.modificationPenalty.amount == amount;
    }

    // ── leagues ──────────────────────────────────────────────────────────
    match /leagues/{leagueId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.adminUids == [request.auth.uid];

      allow update: if isSuperAdmin() || isLeagueAdmin(leagueId);

      allow delete: if isSuperAdmin() || isLeagueAdmin(leagueId);
    }

    // ── profiles ─────────────────────────────────────────────────────────
    // Identité de l'utilisateur (id = authUid), distincte de l'appartenance
    // à une ligue (players). Chacun ne peut créer/modifier que son propre
    // profil ; suppression réservée au super-admin.
    match /profiles/{profileId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == profileId;
      allow delete: if isSuperAdmin();
    }

    // ── players ──────────────────────────────────────────────────────────
    match /players/{playerId} {
      allow read: if isSignedIn();

      allow update: if isSuperAdmin()
        || isLeagueAdmin(resource.data.leagueId)
        // Self, toggling membership status only (LeaveLeagueSheet.jsx,
        // RejoindreLigue.jsx) — never any other field on one's own doc.
        || (
          resource.data.authUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt'])
        )
        || (
          resource.data.authUid == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid', 'updatedAt'])
          && request.resource.data.authUid == request.auth.uid
        )
        // Self, unlinking on account deletion (MonProfil.jsx) — clears
        // authUid and swaps in a neutral display override, nothing else.
        || (
          resource.data.authUid == request.auth.uid
          && request.resource.data.authUid == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid', 'displayNameOverride', 'updatedAt'])
        );

      allow create: if isSuperAdmin()
        || isLeagueAdmin(request.resource.data.leagueId)
        || request.resource.data.authUid == request.auth.uid;

      // Uses resource.data (the existing document), not request.resource —
      // request.resource is undefined on delete.
      allow delete: if isSuperAdmin() || isLeagueAdmin(resource.data.leagueId);
    }

    // ── predictions ──────────────────────────────────────────────────────
    match /predictions/{predId} {
      allow read: if isSignedIn();

      // create uses request.resource (the document doesn't exist yet, so
      // resource.data would be undefined); update/delete use resource (the
      // existing document), since request.resource is undefined on delete.
      allow create: if isSuperAdmin()
        || isLeagueAdmin(request.resource.data.leagueId)
        || get(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.authUid == request.auth.uid;

      // The "own prediction" clause is field-restricted: a player may only
      // ever touch the content of their own pronostic and its own tracking
      // fields (matches every upsertDoc('predictions', ...) a player
      // triggers themselves, in PredictionSheet.jsx's savePrediction) —
      // never manualUnlockOverride, which must stay admin-only (see
      // ReglagesLigue.jsx's toggleManualUnlock). Without this, a player
      // could grant themselves the "race started" edit-lock exception
      // directly via the API, bypassing the admin-only intent.
      allow update: if isSuperAdmin()
        || isLeagueAdmin(resource.data.leagueId)
        || (
          get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.authUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'prediction', 'initialPrediction', 'submittedAt', 'modifiedAt', 'modificationCount', 'leagueId', 'updatedAt'
          ])
        );

      allow delete: if isSuperAdmin()
        || isLeagueAdmin(resource.data.leagueId)
        || get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.authUid == request.auth.uid;
    }

    // ── penalties ────────────────────────────────────────────────────────
    match /penalties/{penId} {
      allow read: if isSignedIn();

      // Admins can create any penalty. A player can only self-create their
      // own automatic "change" (podium modification) penalty — never for
      // another player, never another type, and never for an amount other
      // than the league's currently configured modificationPenalty amount.
      allow create: if isSuperAdmin()
        || isLeagueAdmin(request.resource.data.leagueId)
        || (
          request.resource.data.type == 'change'
          && isOwnPlayerInLeague(request.resource.data.playerId, request.resource.data.leagueId)
          && matchesModificationPenaltyRule(request.resource.data.leagueId, request.resource.data.amount)
        );

      allow update, delete: if isSuperAdmin() || isLeagueAdmin(resource.data.leagueId);
    }

    // ── races, drivers, races_history, config ───────────────────────────────
    // Données partagées entre toutes les ligues (pas propres à une ligue) :
    // lecture libre, écriture réservée au super-admin uniquement.
    match /races/{raceId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /races_history/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Interdit tout le reste par défaut ───────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
